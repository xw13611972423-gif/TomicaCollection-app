{
  "expo": {
    "name": "TomicaCollection-app",
    "slug": "TomicaCollection-app",
    "version": "2.1.0beta",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "用于拍摄你的多美卡收藏",
